&НаСервере
Процедура ЗагрузитьИзФайлаСервер(ИдентификаторВхранилище, ИмяФайла)
	ДанныеОбзвона = МИКО_аиAPI.ОтправитьФайлНаСервер(ИдентификаторВхранилище, ИмяФайла);	
    Если ТипЗнч(ДанныеОбзвона) = Тип("Массив") Тогда   
		Объект.НомераТелефонов.Очистить();
		Для каждого ДанныеКлиента Из ДанныеОбзвона Цикл                
		 	строкаНомера = Объект.НомераТелефонов.Добавить();
			строкаНомера.Номер = МИКО_аиAPI.УбратьИзСтрокиТелефонаВсеБуквы(ДанныеКлиента.Получить("number"));	
			строкаНомера.Клиент= ДанныеКлиента.Получить("clientId");	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры // ЗагрузитьИзФайла()

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)   
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр = "Excel (*.xls)|*.xls|Excel (*.xlsx)|*.xlsx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл";
	ДанныеОбзвона = Неопределено;
	Если ДиалогОткрытияФайла.Выбрать() Тогда
	    МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
	    Для Каждого ИмяФайла Из МассивФайлов Цикл
			ИдентификаторВхранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла)); 
			ЗагрузитьИзФайлаСервер(ИдентификаторВхранилище, ИмяФайла);		
			прервать;	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

